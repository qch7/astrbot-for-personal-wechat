{
  "id": "wechat_personal",
  "type": "native_wechat",
  "enable": false,
  "server_url": "http://127.0.0.1:6174",
  "account_id": "REPLACE_WITH_ACCOUNT_ID",
  "token_file": "/absolute/path/to/.runtime/private/api-token",
  "state_file": "/absolute/path/to/.runtime/private/wechat_personal-state.json",
  "allowed_groups": [
    "123456789@chatroom"
  ],
  "chat_provider_id": "REPLACE_WITH_ASTRBOT_PROVIDER_ID",
  "context_messages": false,
  "context_skip_prefixes": [
    "/"
  ],
  "resolve_member_names": true,
  "send_images": true,
  "mention_sender": false,
  "strip_markdown": true,
  "proactive_window_seconds": 120,
  "show_member_ids": true,
  "text_mentions": false,
  "receive_media": true,
  "attach_recent_image_seconds": 120,
  "proactive_messages": false,
  "friend_whitelist": false,
  "allowed_friends": []
}
